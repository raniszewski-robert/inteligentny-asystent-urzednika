# Zmienne środowiskowe asystenta UDIP. Skopiuj do .env; .env nie trafia do repozytorium.
# Rdzeń (kalendarz, archiwum, anonimizacja, szablony pism) działa BEZ żadnej zmiennej i bez internetu.

# Opcjonalny model językowy do redakcji akapitów (udip-projekty-odpowiedzi, --mode llm).
# Dowolny serwer zgodny z API OpenAI: Ollama (domyślnie), llama.cpp llama-server, vLLM.
LLM_BASE_URL=http://localhost:11434/v1
# Laptop bez GPU: SpeakLeash/bielik-4.5b-v3.0-instruct:Q8_0 ; serwer z GPU: SpeakLeash/bielik-11b-v3.1-instruct:Q5_K_M
LLM_MODEL=SpeakLeash/bielik-4.5b-v3.0-instruct:Q8_0
# Pusty dla Ollama. Klucz do zewnętrznego API tylko na danych testowych (treść zadania pkt 1), nigdy na danych UMB.
LLM_API_KEY=
# Pokaz w chmurze (dane testowe): UDIP_PROVIDER=gemini i klucz z Google AI Studio
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
