# Skopiuj do .env i uzupelnij. Plik .env dodaj do .gitignore.

# anthropic albo openai_compat (Ollama, llama.cpp, LM Studio)
LLM_PROVIDER=anthropic
# np. claude-haiku-5-5 albo nazwa modelu na lokalnym serwerze
LLM_MODEL=claude-haiku-5-5
# live | cache | replay (replay = demo bez sieci i bez klucza)
LLM_MODE=cache
LLM_CACHE_DIR=.llm_cache
LLM_LOG=.llm_cache/calls.jsonl

# Tylko dla LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Tylko dla LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=

# Opcjonalnie: plik JSON z cenami {"model": [wejscie, wyjscie]} w USD za milion tokenow
LLM_PRICES=
